<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Parent_Must_Be_Previous_Level</fullName>
    <active>true</active>
    <errorConditionFormula><![CDATA[AND(NOT(ISBLANK(bcm_Parent__c)), bcm_Parent__r.bcm_Level__c <> bcm_Level__c - 1)]]></errorConditionFormula>
    <errorMessage>The parent capability must be exactly one level above (e.g. a Level 3 capability must have a Level 2 parent).</errorMessage>
</ValidationRule>

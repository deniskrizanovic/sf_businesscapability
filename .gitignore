# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Playwright auth sessions and run state
tests/e2e/.auth/
tests/e2e/.run_id
tests/e2e/.seed-ids.json
tests/e2e/.diagram_map_url
tests/e2e/.teardown_*.apex

# Playwright test results
playwright-report/
test-results/
test-results-saved/

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Added by Illuminated Cloud
/IlluminatedCloud/
/out/
target/
/.illuminatedCloud/
**/tsconfig*.json
**/*.tsbuildinfo
**/graphql.config.yml

# Local strategy docs
docs/Detailed Strategy Mapping*
docs/homes-nsw-bcm.json

# IDE config
.idea/

# Temporary retrieved org metadata
retrieved_temp/

# AI session artifacts
.ai/
/.claude/scheduled_tasks.lock

# Token cost log — local running log, never clobber on branch switch
tokencost/cost.csv

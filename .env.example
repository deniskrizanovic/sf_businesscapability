# Salesforce org to run E2E tests against
SF_BASE_URL=https://your-org.lightning.force.com
SF_ORG_ALIAS=your-org-alias

# Static test users created by scripts/create-e2e-users.sh.
# Username + password are consumed by create-e2e-users.sh to provision the users.
# They NO LONGER gate browser login — the e2e suite authenticates via the OAuth
# frontdoor flow (see docs/design/09-e2e-test-architecture.md §3).
SF_EDITOR_USERNAME=bcm-editor-test@home-denispoc.e2e
SF_EDITOR_PASSWORD=Bcm@E2Etest1

SF_VIEWER_USERNAME=bcm-viewer-test@home-denispoc.e2e
SF_VIEWER_PASSWORD=Bcm@E2Etest1

# CLI-authed org aliases for the two browser sessions. Authenticate each once:
#   sf org login web -a bcm-editor-e2e   (log in as the editor test user)
#   sf org login web -a bcm-viewer-e2e   (log in as the viewer test user)
# auth.setup.ts mints each browser session from these aliases' stored OAuth tokens.
SF_EDITOR_ALIAS=bcm-editor-e2e
SF_VIEWER_ALIAS=bcm-viewer-e2e

# Salesforce org to run E2E tests against
SF_BASE_URL=https://your-org.lightning.force.com
SF_ORG_ALIAS=your-org-alias

# Static test users created by scripts/create-e2e-users.sh.
# Username + password are consumed by create-e2e-users.sh to provision the users.
# They NO LONGER gate browser login — the e2e suite authenticates via the OAuth
# frontdoor flow (see docs/design/09-e2e-test-architecture.md §3).
# In jwt mode SF_EDITOR_USERNAME / SF_VIEWER_USERNAME ALSO identify the user each
# in-process JWT-bearer exchange authenticates as (`sub` claim).
SF_EDITOR_USERNAME=bcm-editor-test@home-denispoc.e2e
SF_EDITOR_PASSWORD=Bcm@E2Etest1

SF_VIEWER_USERNAME=bcm-viewer-test@home-denispoc.e2e
SF_VIEWER_PASSWORD=Bcm@E2Etest1

# CLI-authed org aliases for the two browser sessions — WEB MODE ONLY.
# In web mode auth.setup.ts mints each browser session from these aliases' stored
# OAuth tokens (`sf org open`). In jwt mode these are NOT required or consumed —
# the in-process flow keys off username + key + client id + instance-url.
SF_EDITOR_ALIAS=bcm-editor-e2e
SF_VIEWER_ALIAS=bcm-viewer-e2e

# ─────────────────────────────────────────────────────────────────────────────
# Auth strategy: how each alias above becomes authenticated before the frontdoor
# exchange. See docs/design/09-e2e-test-architecture.md §3.
#   web  (default) — alias pre-authed once by a human: `sf org login web -a <alias>`.
#                    Zero jwt vars needed. This is today's behavior.
#   jwt            — token minted in-process per run via an RFC 7523 JWT-bearer
#                    exchange (no `sf` CLI, no alias). Cold-start / CI capable.
#                    Requires the SF_JWT_* vars below.
# Unset == web. Any other value fails fast with a diagnostic.
SF_AUTH_MODE=web

# ── jwt-mode only ────────────────────────────────────────────────────────────
# Consumer key of the "BCM E2E JWT" External Client App. GENERATED by Salesforce
# on ECA create — read it AFTER deploying the ECA (see the change apply steps),
# it cannot be known up front.
SF_JWT_CLIENT_ID=

# Path to the ECA's X.509 PRIVATE key (PEM). Generated locally via openssl and
# gitignored (secrets/, *.key, *.pem) — NEVER commit it. When CI is introduced,
# supply this file from a CI secret store, not the repo.
SF_JWT_KEY_FILE=secrets/bcm-e2e-jwt.key

# JWT audience / login host — POSTed to <SF_JWT_INSTANCE_URL>/services/oauth2/token
# and set as the assertion `aud` claim.
# TRAP: for a SANDBOX org this MUST be https://test.salesforce.com — NOT the
# my-domain URL. Using the my-domain host makes the token exchange fail with an
# opaque audience error. Production orgs use https://login.salesforce.com.
# The frontdoor URL is built from the token response `instance_url` (org
# my-domain host), NOT this audience host.
SF_JWT_INSTANCE_URL=https://test.salesforce.com
